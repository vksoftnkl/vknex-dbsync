# Copy to .env next to the binary and fill in. Real environment variables win over this file.

# Local database (source of truth)
SYNC_SOURCE_URL=postgres://postgres:vksoftwares2407@localhost:5432/ERP

# Live database on 169.58.213.171 (Postgres listens on localhost only). Open the tunnel first:
#   ssh -N -L 15432:127.0.0.1:5432 root@169.58.213.171
SYNC_TARGET_URL=SYNC_TARGET_URL=postgres://postgres:vksoftwares2407@127.0.0.1:5432/erp_rehearsal?sslmode=disable

# incremental (default) or full (truncate + reload, needs SYNC_YES=true)
SYNC_MODE=incremental

# Run every 5 minutes; remove or set 0 to run once and exit
SYNC_INTERVAL=5m

# Schema and table selection
SYNC_SCHEMA=public
SYNC_EXCLUDE=_prisma_migrations,sync_deleted_rows
# SYNC_INCLUDE=Product,Category
# SYNC_SCHEMA takes a list, e.g. public,fixed,accounts,sales,stock,inventory,audit,purchase

# Apply the local structure to live before the data: new and changed tables, columns,
# partitions, enum types, functions, constraints and indexes. The target user must own the tables.
SYNC_DDL=false
# Also drop tables, partitions and columns that were deleted locally (their live data is lost)
SYNC_DDL_DROP=false

# After each run, write the sync time into every table's ..._sync_date column (live and local)
# for the rows that were waiting, and into sync_deleted_rows. Only for the real live target.
SYNC_MARK_SYNCED=false

# Change-tracking columns (Prisma @updatedAt). First match per table wins.
SYNC_UPDATED_COLS=updatedAt,updated_at

# Re-read this much before the last watermark on every run (covers clock skew / slow commits)
SYNC_OVERLAP=5m

# Mirror deletes (needed for an identical copy)
SYNC_DELETES=true

# Skip FK checks/triggers on the target during the sync (RDS master user only)
SYNC_DISABLE_TRIGGERS=false

SYNC_LOCK_TIMEOUT=30s

# Append the logs to this file instead of the console. The Windows background build
# (double-clicked, no console) logs to vknex-dbsync.log next to the exe without it.
# SYNC_LOG_FILE=vknex-dbsync.log

# Mirror master tables within seconds of a change (needs SYNC_INTERVAL). Adds a small
# notify trigger to each of them on the local database (schema vknex_sync).
SYNC_INSTANT=true
# Transaction tables: synced only every SYNC_INTERVAL. Every other synced table is instant.
# Partitioned tables must stay in this list.
SYNC_TXN_TABLES=accounts.acc_bill_adjustment,accounts.acc_bill_balance,accounts.acc_opening_balance,accounts.acc_pdc_register,accounts.acc_settlement_import,accounts.acc_settlement_line,accounts.acc_temp_credit,accounts.acc_tender_detail,accounts.acc_voucher_doc_detail,accounts.acc_voucher_doc_einvoice,accounts.acc_voucher_doc_ewaybill,accounts.acc_voucher_doc_register,accounts.acc_voucher_header,accounts.acc_vouchers,accounts.till_approval,accounts.till_business_day,accounts.till_cash_movement,accounts.till_count,accounts.till_count_line,accounts.till_event,accounts.till_session,accounts.till_session_review,accounts.till_variance,accounts.till_void,public.gst_api_log,public.print_log,public.txn_charge_detail,public.txn_hold,public.txn_status_log,public.txn_transport_detail,sales.loyalty_coupon_txn,sales.loyalty_gift_redeem,sales.loyalty_gift_redeem_item,sales.loyalty_ledger,sales.promotion_usage,sales.sale_bill,sales.sale_bill_item,sales.sale_dc,sales.sale_dc_item,sales.sale_dc_return,sales.sale_dc_return_item,sales.sale_order,sales.sale_order_item,sales.sale_quotation,sales.sale_quotation_item,sales.sale_return,sales.sale_return_item,stock.stock_ledger,stock.stock_reservation,stock.stock_voucher,stock.stock_voucher_item,audit.audit_log,audit.user_login_sessions,accounts.acc_voucher_seq,accounts.acc_tds_register,accounts.acc_tcs_register,accounts.acc_opening_run,inventory.item_stock_balance,inventory.item_stock_ledger,inventory.item_batch_stock,inventory.item_batch_master,stock.stock_balance,stock.stock_lot,stock.stock_item_cost,stock.stock_transit,stock.stock_valuation_snap,stock.stock_demand_daily,stock.stock_forecast,sales.loyalty_member,sales.loyalty_coupon,public.gst_auth_session
