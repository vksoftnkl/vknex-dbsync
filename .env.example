# Copy to .env next to the binary and fill in. Real environment variables win over this file.

# Local database (source of truth)
SYNC_SOURCE_URL=postgres://postgres:vksoftwares2407@localhost:5432/ERP

# Live database on 169.58.213.171 (Postgres listens on localhost only), reached through an
# SSH tunnel on local port 5433. 127.0.0.1:5432 here would be the local source server.
# deploy/linux/install.sh erp-vps keeps the tunnel open; by hand:
#   ssh -N -L 5433:127.0.0.1:5432 root@169.58.213.171
SYNC_TARGET_URL=postgres://postgres:vksoftwares2407@127.0.0.1:5433/erp_rehearsal?sslmode=disable

# incremental (default) or full (truncate + reload, needs SYNC_YES=true)
SYNC_MODE=incremental

# Run every 5 minutes; remove or set 0 to run once and exit
SYNC_INTERVAL=5m

# Schema and table selection
SYNC_SCHEMA=public
SYNC_EXCLUDE=_prisma_migrations,sync_deleted_rows
# SYNC_INCLUDE=Product,Category
# SYNC_SCHEMA takes a list, e.g. public,fixed,accounts,sales,stock,inventory,audit,purchase

# Apply the local structure to live before the data: new and changed tables, columns,
# partitions, enum types, functions, constraints and indexes. The target user must own the tables.
SYNC_DDL=false
# Also drop tables, partitions and columns that were deleted locally (their live data is lost)
SYNC_DDL_DROP=false

# After each run, write the sync time into every table's sync column (dtm_sync_col in
# public.db_table_master, else its ..._sync_date column), live and local, for the rows that
# were waiting, and into sync_deleted_rows. Only for the real live target.
SYNC_MARK_SYNCED=false
# false = only the master tables get the sync time (the instant ones, see SYNC_TABLE_MASTER; with
# SYNC_INSTANT, on every instant sync), the transaction tables are left as they are
SYNC_MARK_TXN=false

# Change-tracking columns (Prisma @updatedAt). First match per table wins.
SYNC_UPDATED_COLS=updatedAt,updated_at

# Re-read this much before the last watermark on every run (covers clock skew / slow commits)
SYNC_OVERLAP=5m

# Mirror deletes (needed for an identical copy)
SYNC_DELETES=true

# Skip FK checks/triggers on the target during the sync (RDS master user only)
SYNC_DISABLE_TRIGGERS=false

SYNC_LOCK_TIMEOUT=30s

# Append the logs to this file instead of the console. The Windows background build
# (double-clicked, no console) logs to vknex-dbsync.log next to the exe without it.
# SYNC_LOG_FILE=vknex-dbsync.log

# Status page, served while SYNC_INTERVAL is set: the desktop icon (Linux) or a second
# double-click on the exe (Windows) opens it, or browse to http://127.0.0.1:7645/. Empty = none.
# SYNC_UI=127.0.0.1:7645

# Mail these addresses (comma-separated) when a sync fails, when it works again and when the
# program stops (Ctrl-C, systemctl stop, End task, crash). One mail when a sync starts failing,
# then one every SYNC_MAIL_REPEAT (default 1h) while it keeps failing. Empty = no mail.
SYNC_MAIL_TO=prathapprasanna269@gmail.com
# The account that sends them. Gmail: smtp.gmail.com:587 with an app password (Google account >
# Security > 2-Step Verification > App passwords); the normal account password does not work.
# Check the settings with: vknex-dbsync -mail-test
SYNC_SMTP=smtp.gmail.com:587
SYNC_SMTP_USER=vksoftaresnkl@gmail.com
SYNC_SMTP_PASSWORD=fzet uwui kgcr rssk
# Sender address, default SYNC_SMTP_USER
# SYNC_MAIL_FROM=

# Mirror master tables within seconds of a change (needs SYNC_INTERVAL). Adds a small
# notify trigger to each of them on the local database (schema vknex_sync).
SYNC_INSTANT=true
# No table list here: dtm_kind in public.db_table_master on the local database decides, read
# on every run. MASTER, SETTING, METADATA, LEDGER, BALANCE, SYSTEM: instant. TRANSACTION (and
# tables it does not list): every SYNC_INTERVAL. LOG: every hour. Add or change a row there and
# it takes effect within seconds, no restart needed.

# Let the master tables be edited on the live DB too: rows inserted, changed or deleted there come
# back to the local DB (with SYNC_INSTANT within a second). Needs SYNC_MARK_SYNCED. Puts a capture
# trigger on each of them on the live DB. dtm_kind picks the tables: SYNC_TWO_WAY_KINDS (MASTER).
SYNC_TWO_WAY=false
# A row changed on both sides since the last sync: local keeps the local version, live the live one
# SYNC_TWO_WAY_WINS=local
# Rows created on the live DB get ids from this number on, so they never take an id a local row has
# SYNC_TWO_WAY_LIVE_IDS=1000000000
