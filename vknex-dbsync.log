time=2026-10-23T13:22:35.800+05:30 level=INFO msg="schema change" sql="CREATE TABLE \"inventory\".\"item_price_change_log\" (\n  \"ipcl_id\" uuid DEFAULT uuidv7() NOT NULL,\n  \"ipcl_changed_on\" timestamp with time zone DEFAULT now() NOT NULL,\n  \"ipcl_change_set_id\" uuid NOT NULL,\n  \"ipcl_price_table\" character varying(4) NOT NULL,\n  \"ipcl_row_id\" uuid NOT NULL,\n  \"ipcl_action\" character varying(10) NOT NULL,\n  \"ipcl_source\" character varying(30) NOT NULL,\n  \"ipcl_menu_id\" integer,\n  \"ipcl_company_id\" uuid,\n  \"ipcl_branch_id\" uuid,\n  \"ipcl_item_id\" uuid NOT NULL,\n  \"ipcl_unit_id\" uuid,\n  \"ipcl_godown_id\" uuid,\n  \"ipcl_party_id\" uuid,\n  \"ipcl_price_level\" smallint,\n  \"ipcl_bucket_mrp\" numeric(18,2),\n  \"ipcl_bucket_sp\" numeric(18,2),\n  \"ipcl_effective_from\" date,\n  \"ipcl_effective_to\" date,\n  \"ipcl_item_code\" character varying(60),\n  \"ipcl_item_name\" character varying(250),\n  \"ipcl_unit_name\" character varying(60),\n  \"ipcl_branch_name\" character varying(120),\n  \"ipcl_godown_name\" character varying(120),\n  \"ipcl_party_name\" character varying(250),\n  \"ipcl_user_id\" uuid,\n  \"ipcl_user_name\" character varying(150),\n  \"ipcl_device_id\" uuid,\n  \"ipcl_device_name\" character varying(150),\n  \"ipcl_ip\" character varying(60),\n  \"ipcl_app\" character varying(30),\n  \"ipcl_reason\" character varying(500),\n  \"ipcl_sync_date\" timestamp with time zone,\n  \"ipcl_before\" jsonb,\n  \"ipcl_after\" jsonb,\n  \"ipcl_changed\" text[] NOT NULL,\n  \"ipcl_old_price_a\" numeric GENERATED ALWAYS AS (((ipcl_before ->> 'ipm_sales_price_a'::text))::numeric) STORED,\n  \"ipcl_new_price_a\" numeric GENERATED ALWAYS AS (((ipcl_after ->> 'ipm_sales_price_a'::text))::numeric) STORED,\n  \"ipcl_old_mrp\" numeric GENERATED ALWAYS AS (((ipcl_before ->> 'ipm_max_price'::text))::numeric) STORED,\n  \"ipcl_new_mrp\" numeric GENERATED ALWAYS AS (((ipcl_after ->> 'ipm_max_price'::text))::numeric) STORED,\n  \"ipcl_old_cost\" numeric GENERATED ALWAYS AS (((ipcl_before ->> 'ipm_cost_price'::text))::numeric) STORED,\n  \"ipcl_new_cost\" numeric GENERATED ALWAYS AS (((ipcl_after ->> 'ipm_cost_price'::text))::numeric) STORED,\n  \"ipcl_old_slab_price\" numeric GENERATED ALWAYS AS (((ipcl_before ->> 'iqp_price'::text))::numeric) STORED,\n  \"ipcl_new_slab_price\" numeric GENERATED ALWAYS AS (((ipcl_after ->> 'iqp_price'::text))::numeric) STORED,\n  \"ipcl_slab_from_qty\" numeric GENERATED ALWAYS AS (((COALESCE(ipcl_after, ipcl_before) ->> 'iqp_from_qty'::text))::numeric) STORED,\n  \"ipcl_slab_to_qty\" numeric GENERATED ALWAYS AS (((COALESCE(ipcl_after, ipcl_before) ->> 'iqp_to_qty'::text))::numeric) STORED\n)"
